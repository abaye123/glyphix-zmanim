<template>
  <scroll class="page">
    <div class="top-space"></div>
    <text class="title">{{title}}</text>
    <text class="sub">{{civil}}</text>
    <div class="add" on:click="add"><text class="add-text">הוסף תזכורת</text></div>
    <div for="r in reminders" class="rem" on:click="edit(r.id)">
      <text class="rem-time">{{r.time}}</text>
      <text class="rem-text">{{r.text}}</text>
    </div>
    <text class="sub">{{city}}</text>
    <div for="z in rows" class="row">
      <text class="time">{{z.time}}</text>
      <text class="name">{{z.name}}</text>
    </div>
    <div class="bottom-space"></div>
  </scroll>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .top-space {
    width: 10px;
    height: 48px;
  }

  .bottom-space {
    width: 10px;
    height: 90px;
  }

  .title {
    font-size: 25px;
    color: #ffd65a;
    width: 340px;
    text-align: center;
    margin-bottom: 8px;
  }

  .sub {
    font-size: 22px;
    color: #b8b8cc;
    width: 300px;
    text-align: center;
    margin-bottom: 8px;
  }

  .add {
    width: 240px;
    height: 58px;
    border-radius: 29px;
    background-color: #ffa040;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .add-text {
    font-size: 26px;
    color: #141420;
  }

  .rem {
    width: 350px;
    height: 76px;
    margin-bottom: 8px;
    border-radius: 20px;
    background-color: #3a2410;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .rem-time {
    font-size: 20px;
    color: #ffa040;
  }

  .rem-text {
    font-size: 25px;
    color: #ffffff;
    max-width: 310px;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .row {
    width: 360px;
    height: 50px;
    margin-bottom: 4px;
    padding: 0 12px;
    border-radius: 14px;
    background-color: #16161f;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .time {
    font-size: 24px;
    color: #ffd65a;
  }

  .name {
    font-size: 24px;
    color: #ffffff;
  }
</style>

<script>
  import router from '@system.router'
  import { dateTitle, weekdayOf, MONTHS } from '../lib/month.js'
  import { zmanimFor, clock, ROWS } from '../lib/zmanim.js'
  import { CITIES } from '../lib/cities.js'
  import { loadCity } from '../lib/settings.js'
  import { ofDay, getReminder, timeText } from '../lib/reminders.js'
  import { nav, newDraft, draftOf } from '../lib/nav.js'

  export default {
    data: {
      title: '',
      civil: '',
      city: '',
      reminders: [],
      rows: []
    },
    day: null,
    onInit() {
      const t = new Date()
      this.day = nav.day || [t.getFullYear(), t.getMonth() + 1, t.getDate()]
    },
    onShow() {
      const y = this.day[0], m = this.day[1], d = this.day[2]
      const city = CITIES[loadCity() || 0]
      const times = zmanimFor(city, y, m, d), weekday = weekdayOf(y, m, d)
      this.title = dateTitle(y, m, d)
      this.civil = d + ' ב' + MONTHS[m - 1] + ' ' + y
      this.city = 'זמנים: ' + city.name
      this.reminders = ofDay(y, m, d).map(r => ({ id: r.id, text: r.text, time: timeText(r.at) }))
      this.rows = ROWS.filter(i => i[2] === undefined || i[2] === weekday).map(i => ({ time: clock(times[i[0]]), name: i[1] }))
    },
    add() {
      nav.draft = newDraft(this.day)
      router.push({ uri: 'edit' })
    },
    edit(id) {
      const r = getReminder(id)
      if (!r) return
      nav.draft = draftOf(r)
      router.push({ uri: 'edit' })
    }
  }
</script>
