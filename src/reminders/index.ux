<template>
  <scroll class="page">
    <div class="top-space"></div>
    <text class="title">תזכורות</text>
    <div class="add" on:click="add"><text class="add-text">תזכורת חדשה</text></div>
    <text if="{{missedRows.length}}" class="head bad">הוחמצו</text>
    <div for="r in missedRows" class="rem missed" on:click="edit(r.id)">
      <text class="rem-time">{{r.time}}</text>
      <text class="rem-text">{{r.text}}</text>
    </div>
    <div if="{{missedRows.length}}" class="wide" on:click="dismiss"><text class="wide-text">ראיתי, נקה</text></div>
    <text class="head">{{nextHead}}</text>
    <div for="r in nextRows" class="rem" on:click="edit(r.id)">
      <text class="rem-time">{{r.time}}</text>
      <text class="rem-text">{{r.text}}</text>
    </div>
    <div class="bottom-space"></div>
  </scroll>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .top-space {
    width: 10px;
    height: 48px;
  }

  .bottom-space {
    width: 10px;
    height: 90px;
  }

  .title {
    font-size: 28px;
    color: #ffd65a;
    width: 300px;
    text-align: center;
    margin-bottom: 8px;
  }

  .add {
    width: 240px;
    height: 58px;
    border-radius: 29px;
    background-color: #ffa040;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .add-text {
    font-size: 26px;
    color: #141420;
  }

  .rem {
    width: 350px;
    height: 76px;
    margin-bottom: 8px;
    border-radius: 20px;
    background-color: #3a2410;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .rem-time {
    font-size: 20px;
    color: #ffa040;
  }

  .rem-text {
    font-size: 25px;
    color: #ffffff;
    max-width: 310px;
    max-lines: 1;
    text-overflow: ellipsis;
  }

  .missed {
    background-color: #6a1c1c;
  }

  .head {
    font-size: 24px;
    color: #b8b8cc;
    width: 320px;
    text-align: center;
    margin-bottom: 8px;
  }

  .bad {
    color: #ff7070;
  }

  .wide {
    width: 220px;
    height: 52px;
    border-radius: 26px;
    background-color: #2a1f5c;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wide-text {
    font-size: 24px;
    color: #ffffff;
  }
</style>

<script>
  import router from '@system.router'
  import { upcoming, missed, dismissMissed, getReminder, timeText, checkDue } from '../lib/reminders.js'
  import { WEEKDAYS } from '../lib/month.js'
  import { nav, newDraft, draftOf } from '../lib/nav.js'

  function row(r) {
    const t = new Date(r.at)
    return {
      id: r.id,
      text: r.text,
      time: 'יום ' + WEEKDAYS[t.getDay()] + ' ' + t.getDate() + '/' + (t.getMonth() + 1) + ' בשעה ' + timeText(r.at)
    }
  }

  export default {
    data: {
      missedRows: [],
      nextRows: [],
      nextHead: ''
    },
    onShow() {
      checkDue()
      this.refresh()
    },
    refresh() {
      this.missedRows = missed().map(row)
      this.nextRows = upcoming().map(row)
      this.nextHead = this.nextRows.length ? 'הבאות' : 'אין תזכורות קרובות'
    },
    dismiss() {
      dismissMissed()
      this.refresh()
    },
    add() {
      nav.draft = newDraft(null)
      router.push({ uri: 'edit' })
    },
    edit(id) {
      const r = getReminder(id)
      if (!r) return
      nav.draft = draftOf(r)
      router.push({ uri: 'edit' })
    }
  }
</script>
