<template>
  <scroll class="page">
    <div class="top-space"></div>
    <text class="title">בחירת עיר</text>
    <div for="c in cities" class="item" on:click="pick(c.index)">
      <text class="name">{{c.name}}</text>
    </div>
    <div class="bottom-space"></div>
  </scroll>
</template>

<style>
  .top-space {
    width: 10px;
    height: 48px;
  }

  .bottom-space {
    width: 10px;
    height: 80px;
  }

  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .title {
    font-size: 30px;
    color: #ffd65a;
    margin-bottom: 12px;
  }

  .item {
    width: 340px;
    height: 72px;
    margin-bottom: 8px;
    border-radius: 36px;
    background-color: #2a1f5c;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .name {
    font-size: 30px;
    color: #ffffff;
    text-align: center;
  }
</style>

<script>
  import router from '@system.router'
  import { CITIES } from '../lib/cities.js'
  import { saveCity } from '../lib/settings.js'

  export default {
    data: {
      cities: CITIES.map((c, i) => ({ name: c.name, index: i }))
    },
    pick(index) {
      saveCity(index)
      router.back()
    }
  }
</script>
